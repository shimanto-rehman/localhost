# PostgreSQL (use Neon/Supabase/Railway with connection pooler for production)
# Copy these two lines into BOTH `.env` (for Prisma) and `.env.local` (for Next.js)
DATABASE_URL="postgresql://user:password@host-pooler.region.aws.neon.tech/dbname?sslmode=require"
DIRECT_DATABASE_URL="postgresql://user:password@host.region.aws.neon.tech/dbname?sslmode=require"

# Auth & encryption (generate secure random values — never commit real secrets)
JWT_SECRET="your-64-char-or-longer-random-secret-for-jwt-signing-change-me-in-production"
ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# Public site URL (used for SEO, sitemap, password reset emails)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Vercel Cron — monthly jobs (1st of month). Set a long random secret; Vercel sends Authorization: Bearer <secret>
CRON_SECRET=""

RESEND_API_KEY=""
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="noreply@yourdomain.com"
